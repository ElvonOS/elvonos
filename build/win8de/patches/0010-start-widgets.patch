 // ----------------------------
 // AppLauncher class (FULL VERSION WITH CACHING + ASYNC)
 // ----------------------------
+
+/* ---------------- System information (widgets) ---------------- */
+
+class SystemInfo : public QObject {
+  Q_OBJECT
+  Q_PROPERTY(double cpuLoad READ cpuLoad NOTIFY updated)
+  Q_PROPERTY(double memoryPercent READ memoryPercent NOTIFY updated)
+  Q_PROPERTY(int memoryUsedMb READ memoryUsedMb NOTIFY updated)
+  Q_PROPERTY(int memoryTotalMb READ memoryTotalMb NOTIFY updated)
+  Q_PROPERTY(int batteryPercent READ batteryPercent NOTIFY updated)
+  Q_PROPERTY(bool charging READ charging NOTIFY updated)
+
+public:
+  explicit SystemInfo(QObject *parent = nullptr) : QObject(parent) {
+    auto *timer = new QTimer(this);
+    timer->setInterval(2000);
+    connect(timer, &QTimer::timeout, this, &SystemInfo::refresh);
+    timer->start();
+    refresh();
+  }
+
+  double cpuLoad() const { return m_cpu; }
+  double memoryPercent() const { return m_memoryPercent; }
+  int memoryUsedMb() const { return m_memoryUsedMb; }
+  int memoryTotalMb() const { return m_memoryTotalMb; }
+  int batteryPercent() const { return m_battery; }
+  bool charging() const { return m_charging; }
+
+signals:
+  void updated();
+
+private:
+  void refresh() {
+    QFile meminfo("/proc/meminfo");
+    if (meminfo.open(QIODevice::ReadOnly)) {
+      const QString text = QString::fromLatin1(meminfo.readAll());
+      const QRegularExpression totalRe("MemTotal:\\s+(\\d+)");
+      const QRegularExpression availRe("MemAvailable:\\s+(\\d+)");
+      const auto totalMatch = totalRe.match(text);
+      const auto availMatch = availRe.match(text);
+      if (totalMatch.hasMatch() && availMatch.hasMatch()) {
+        const int totalKb = totalMatch.captured(1).toInt();
+        const int availKb = availMatch.captured(1).toInt();
+        m_memoryTotalMb = totalKb / 1024;
+        m_memoryUsedMb = (totalKb - availKb) / 1024;
+        m_memoryPercent = totalKb > 0 ? 100.0 * (totalKb - availKb) / totalKb : 0.0;
+      }
+    }
+
+    QFile loadavg("/proc/loadavg");
+    if (loadavg.open(QIODevice::ReadOnly)) {
+      const double load = QString::fromLatin1(loadavg.readAll()).split(' ').first().toDouble();
+      int cores = QThread::idealThreadCount();
+      if (cores < 1)
+        cores = 1;
+      m_cpu = qBound(0.0, 100.0 * load / cores, 100.0);
+    }
+
+    m_battery = -1;
+    m_charging = false;
+    QDir powerSupply("/sys/class/power_supply");
+    for (const QString &entry : powerSupply.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+      if (!entry.startsWith("BAT"))
+        continue;
+      QFile capacity(powerSupply.filePath(entry) + "/capacity");
+      if (capacity.open(QIODevice::ReadOnly))
+        m_battery = QString::fromLatin1(capacity.readAll()).trimmed().toInt();
+      QFile status(powerSupply.filePath(entry) + "/status");
+      if (status.open(QIODevice::ReadOnly)) {
+        const QString state = QString::fromLatin1(status.readAll()).trimmed();
+        m_charging = state == "Charging" || state == "Full";
+      }
+      break;
+    }
+
+    emit updated();
+  }
+
+  double m_cpu = 0.0;
+  double m_memoryPercent = 0.0;
+  int m_memoryUsedMb = 0;
+  int m_memoryTotalMb = 0;
+  int m_battery = -1;
+  bool m_charging = false;
+};
+

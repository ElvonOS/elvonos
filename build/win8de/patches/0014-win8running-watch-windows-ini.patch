+                watcher.addPath(iniPath);
+            reload();
+        });
+        connect(&watcher, &QFileSystemWatcher::directoryChanged, this, [this] {
+            if (!watcher.files().contains(iniPath) && QFileInfo::exists(iniPath))
+                watcher.addPath(iniPath);
+            reload();
+        });
+        QTimer::singleShot(900, this, [this] {
+            if (!watcher.files().contains(iniPath) && QFileInfo::exists(iniPath))
                 watcher.addPath(iniPath);
             reload();

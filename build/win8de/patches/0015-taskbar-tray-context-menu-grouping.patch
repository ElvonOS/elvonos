+import QtQuick
+import QtQuick.Controls
+
+Window {
+    id: menuWindow
+    width: 264
+    height: menuColumn.implicitHeight + 16
+    visible: false
+    color: "transparent"
+    flags: Qt.FramelessWindowHint
+    title: "Taskbar Menu"
+
+    component MenuItem: Rectangle {
+        id: item
+        property string label: ""
+        property bool danger: false
+        signal activated()
+
+        width: menuColumn.width
+        height: 32
+        radius: 8
+        color: itemHover.hovered ? (danger ? "#3A1E1E" : "#1A2A3945") : "transparent"
+
+        Text {
+            anchors.left: parent.left
+            anchors.leftMargin: 10
+            anchors.verticalCenter: parent.verticalCenter
+            text: item.label
+            color: item.danger ? "#FFB4B0" : "#E9ECF2"
+            font.pixelSize: 10
+        }
+
+        HoverHandler { id: itemHover }
+
+        MouseArea {
+            anchors.fill: parent
+            cursorShape: Qt.PointingHandCursor
+            onClicked: item.activated()
+        }
+    }
+
+    component Divider: Rectangle {
+        width: menuColumn.width
+        height: 1
+        color: "#22FFFFFF"
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: 14
+        color: "#FA101017"
+        border.width: 1
+        border.color: "#33FFFFFF"
+        clip: true
+
+        Rectangle {
+            anchors.top: parent.top
+            anchors.left: parent.left
+            anchors.right: parent.right
+            height: 1
+            color: "#26FFFFFF"
+        }
+
+        Column {
+            id: menuColumn
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+            anchors.margins: 8
+            spacing: 2
+
+            Item {
+                width: menuColumn.width
+                height: 40
+
+                Column {
+                    anchors.left: parent.left
+                    anchors.leftMargin: 10
+                    anchors.verticalCenter: parent.verticalCenter
+                    spacing: 1
+
+                    Text {
+                        width: menuColumn.width - 20
+                        text: TaskbarMenu.title
+                        color: "#F2F4F8"
+                        font.pixelSize: 11
+                        font.weight: Font.DemiBold
+                        elide: Text.ElideRight
+                    }
+
+                    Text {
+                        visible: TaskbarMenu.windowCount > 1
+                        text: TaskbarMenu.windowCount + " windows in this group"
+                        color: "#7D8490"
+                        font.pixelSize: 8
+                    }
+                }
+            }
+
+            Divider {}
+
+            MenuItem {
+                label: "Activate"
+                visible: TaskbarMenu.hasWindow
+                onActivated: TaskbarMenu.activateSelected()
+            }
+            MenuItem {
+                label: "Minimize"
+                visible: TaskbarMenu.hasWindow
+                onActivated: TaskbarMenu.minimizeSelected()
+            }
+            MenuItem {
+                label: TaskbarMenu.maximized ? "Restore" : "Maximize"
+                visible: TaskbarMenu.hasWindow
+                onActivated: TaskbarMenu.toggleMaximizedSelected()
+            }
+
+            Divider { visible: TaskbarMenu.hasWindow }
+
+            MenuItem {
+                label: "Close"
+                danger: true
+                visible: TaskbarMenu.hasWindow
+                onActivated: TaskbarMenu.closeSelected()
+            }
+            MenuItem {
+                label: "Close all " + TaskbarMenu.windowCount + " windows"
+                danger: true
+                visible: TaskbarMenu.windowCount > 1
+                onActivated: TaskbarMenu.closeAllSelected()
+            }
+
+            Divider { visible: TaskbarMenu.hasWindow }
+
+            MenuItem {
+                label: "Close active window"
+                danger: true
+                visible: !TaskbarMenu.hasWindow && TaskbarMenu.activeWindow
+                onActivated: TaskbarMenu.closeActive()
+            }
+            MenuItem {
+                label: "Minimize all windows"
+                visible: !TaskbarMenu.hasWindow
+                onActivated: TaskbarMenu.minimizeAllWindows()
+            }
+            MenuItem {
+                label: "Task Manager"
+                onActivated: TaskbarMenu.openTaskManager()
+            }
+            MenuItem {
+                label: "Taskbar settings"
+                onActivated: TaskbarMenu.openSettings()
+            }
+        }
+    }
+
+    Shortcut {
+        sequence: "Escape"
+        onActivated: TaskbarMenu.hide()
+    }

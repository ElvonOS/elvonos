-/* ---------------- Window Item ---------------- */
+public slots:
+    void refresh()
+    {
+        refreshVolume();
+        refreshNetwork();
+        refreshBattery();
+        emit trayChanged();
+    }
+
+signals:
+    void trayChanged();
+
+private:
+    void refreshVolume()
+    {
+        int percent = 0;
+        bool muted = false;
+        bool found = false;
+
+        const QString wireplumber =
+            runText(QStringLiteral("wpctl"),
+                    {QStringLiteral("get-volume"), QStringLiteral("@DEFAULT_AUDIO_SINK@")});
+        QRegularExpression re(QStringLiteral("Volume:\\s*([0-9]+(?:[.,][0-9]+)?)"));
+        const QRegularExpressionMatch match = re.match(wireplumber);
+        if (match.hasMatch()) {
+            percent = qRound(match.captured(1).replace(QLatin1Char(','), QLatin1Char('.'))
+                                 .toDouble() * 100.0);
+            muted = wireplumber.contains(QStringLiteral("[MUTED]"));
+            found = true;
+        } else {
+            const QString pulse = runText(QStringLiteral("pactl"),
+                                          {QStringLiteral("get-sink-volume"),
+                                           QStringLiteral("@DEFAULT_SINK@")});
+            const QRegularExpressionMatch pulseMatch =
+                QRegularExpression(QStringLiteral("(\\d+)%")).match(pulse);
+            if (pulseMatch.hasMatch()) {
+                percent = pulseMatch.captured(1).toInt();
+                const QString mute = runText(QStringLiteral("pactl"),
+                                             {QStringLiteral("get-sink-mute"),
+                                              QStringLiteral("@DEFAULT_SINK@")});
+                muted = mute.contains(QStringLiteral("yes"), Qt::CaseInsensitive);
+                found = true;
+            }
+        }
+
+        const int clamped = qBound(0, percent, 100);
+        QString icon;
+        if (!found || muted)
+            icon = QStringLiteral("audio-volume-muted");
+        else if (clamped <= 30)
+            icon = QStringLiteral("audio-volume-low");
+        else if (clamped <= 70)
+            icon = QStringLiteral("audio-volume-medium");
+        else
+            icon = QStringLiteral("audio-volume-high");
+
+        m_volumePercent = clamped;
+        m_volumeMuted = muted;
+        m_volumeIcon = resolveThemeIcon(icon);
+        m_volumeTip = !found ? QStringLiteral("Audio sink unavailable")
+                             : (muted ? QStringLiteral("Muted · %1%").arg(clamped)
+                                      : QStringLiteral("Volume %1%").arg(clamped));
+    }
+
+    void refreshNetwork()
+    {
+        bool online = false;
+        bool wireless = false;
+        QString name;
+
+        const QString state =
+            runText(QStringLiteral("nmcli"),
+                    {QStringLiteral("-t"), QStringLiteral("-f"),
+                     QStringLiteral("STATE"), QStringLiteral("general")});
+        if (state.startsWith(QStringLiteral("connected"))) {
+            online = true;
+            const QString wifi =
+                runText(QStringLiteral("nmcli"),
+                        {QStringLiteral("-t"), QStringLiteral("-f"),
+                         QStringLiteral("ACTIVE,SSID"), QStringLiteral("dev"),
+                         QStringLiteral("wifi")},
+                        1500);
+            for (const QString &line : wifi.split(QLatin1Char('\n'))) {
+                if (line.startsWith(QStringLiteral("yes:"))) {
+                    name = line.mid(4).trimmed();
+                    wireless = true;
+                    break;
+                }
+            }
+            if (name.isEmpty()) {
+                const QString connection =
+                    runText(QStringLiteral("nmcli"),
+                            {QStringLiteral("-t"), QStringLiteral("-f"),
+                             QStringLiteral("NAME"), QStringLiteral("connection"),
+                             QStringLiteral("show"), QStringLiteral("--active")});
+                name = connection.split(QLatin1Char('\n')).value(0).trimmed();
+            }
+        }
+
+        if (!online) {
+            const QDir netDir(QStringLiteral("/sys/class/net"));
+            for (const QString &entry :
+                 netDir.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+                if (entry == QStringLiteral("lo"))
+                    continue;
+                const QString oper =
+                    readTextFile(netDir.filePath(entry) + QStringLiteral("/operstate"));
+                if (oper == QStringLiteral("up")) {
+                    online = true;
+                    name = entry;
+                    wireless = QFileInfo::exists(
+                        netDir.filePath(entry) + QStringLiteral("/wireless"));
+                    break;
+                }
+            }
+        }
+
+        m_networkOnline = online;
+        m_networkName = name;
+        if (!online) {
+            m_networkIcon = resolveThemeIcon(QStringLiteral("network-offline"));
+            m_networkTip = QStringLiteral("Network: offline");
+        } else if (wireless) {
+            m_networkIcon =
+                resolveThemeIcon(QStringLiteral("network-wireless-signal-excellent"));
+            if (m_networkIcon.isEmpty())
+                m_networkIcon = resolveThemeIcon(QStringLiteral("network-wireless"));
+            m_networkTip = QStringLiteral("Wi-Fi: %1").arg(name);
+        } else {
+            m_networkIcon = resolveThemeIcon(QStringLiteral("network-wired"));
+            m_networkTip = QStringLiteral("Network: %1").arg(name);
+        }
+    }
+
+    void refreshBattery()
+    {
+        bool present = false;
+        int percent = 0;
+        bool charging = false;
+
+        const QDir powerDir(QStringLiteral("/sys/class/power_supply"));
+        for (const QString &entry :
+             powerDir.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+            const QString base = powerDir.filePath(entry);
+            if (readTextFile(base + QStringLiteral("/type")) != QStringLiteral("Battery"))
+                continue;
+            present = true;
+            percent = readTextFile(base + QStringLiteral("/capacity")).toInt();
+            const QString status = readTextFile(base + QStringLiteral("/status"));
+            charging = status == QStringLiteral("Charging")
+                       || status == QStringLiteral("Full");
+            break;
+        }
+
+        QString icon;
+        if (!present)
+            icon = QStringLiteral("battery-missing");
+        else if (charging)
+            icon = QStringLiteral("battery-%1-charging").arg(percent >= 90 ? 100
+                                                            : (percent / 10) * 10);
+        else if (percent >= 80)
+            icon = QStringLiteral("battery-full");
+        else if (percent >= 40)
+            icon = QStringLiteral("battery-good");
+        else if (percent >= 15)
+            icon = QStringLiteral("battery-low");
+        else
+            icon = QStringLiteral("battery-caution");
+
+        m_batteryPresent = present;
+        m_batteryPercent = qBound(0, percent, 100);
+        m_batteryCharging = charging;
+        m_batteryIcon = resolveThemeIcon(icon);
+        m_batteryTip = !present ? QStringLiteral("No battery")
+                                : (charging
+                                   ? QStringLiteral("Battery %1% · charging").arg(percent)
+                                   : QStringLiteral("Battery %1%").arg(percent));
+    }
+
+    int m_volumePercent = 0;
+    bool m_volumeMuted = false;
+    QString m_volumeIcon;
+    QString m_volumeTip = QStringLiteral("Volume");
+    bool m_networkOnline = false;
+    QString m_networkName;
+    QString m_networkIcon;
+    QString m_networkTip = QStringLiteral("Network");
+    bool m_batteryPresent = false;
+    int m_batteryPercent = 0;
+    bool m_batteryCharging = false;
+    QString m_batteryIcon;
+    QString m_batteryTip = QStringLiteral("Battery");
+};

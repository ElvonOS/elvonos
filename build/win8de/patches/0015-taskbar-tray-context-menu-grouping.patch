+/* ---------------- Taskbar settings ---------------- */
+
+class TaskbarSettings : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(int height READ height NOTIFY heightChanged)
+    Q_PROPERTY(bool groupDuplicates READ groupDuplicates NOTIFY groupDuplicatesChanged)
+    Q_PROPERTY(bool showTray READ showTray NOTIFY showTrayChanged)
+    Q_PROPERTY(bool showVolume READ showVolume NOTIFY showVolumeChanged)
+    Q_PROPERTY(bool showNetwork READ showNetwork NOTIFY showNetworkChanged)
+    Q_PROPERTY(bool showBattery READ showBattery NOTIFY showBatteryChanged)
+    Q_PROPERTY(bool showClock READ showClock NOTIFY showClockChanged)
+    Q_PROPERTY(bool showCount READ showCount NOTIFY showCountChanged)
+    Q_PROPERTY(bool showTitles READ showTitles NOTIFY showTitlesChanged)
+
+public:
+    explicit TaskbarSettings(QObject *parent = nullptr)
+        : QObject(parent)
+    {
+        m_path = QDir::homePath() + QStringLiteral("/.config/elvonos/taskbar.json");
+        QDir().mkpath(QFileInfo(m_path).absolutePath());
+        reload();
+
+        m_watcher.addPath(QFileInfo(m_path).absolutePath());
+        if (QFileInfo::exists(m_path))
+            m_watcher.addPath(m_path);
+
+        m_reloadTimer.setSingleShot(true);
+        m_reloadTimer.setInterval(250);
+        connect(&m_reloadTimer, &QTimer::timeout, this, &TaskbarSettings::reload);
+        connect(&m_watcher, &QFileSystemWatcher::fileChanged, this, [this] {
+            if (!m_watcher.files().contains(m_path) && QFileInfo::exists(m_path))
+                m_watcher.addPath(m_path);
+            m_reloadTimer.start();
+        });
+        connect(&m_watcher, &QFileSystemWatcher::directoryChanged, this, [this] {
+            if (!m_watcher.files().contains(m_path) && QFileInfo::exists(m_path))
+                m_watcher.addPath(m_path);
+            m_reloadTimer.start();
+        });
     }
+
+    int height() const { return m_height; }
+    bool groupDuplicates() const { return m_groupDuplicates; }
+    bool showTray() const { return m_showTray; }
+    bool showVolume() const { return m_showVolume; }
+    bool showNetwork() const { return m_showNetwork; }
+    bool showBattery() const { return m_showBattery; }
+    bool showClock() const { return m_showClock; }
+    bool showCount() const { return m_showCount; }
+    bool showTitles() const { return m_showTitles; }
+
+public slots:
+    void reload()
+    {
+        QJsonObject object;
+        QFile file(m_path);
+        if (file.open(QIODevice::ReadOnly)) {
+            const QJsonDocument document = QJsonDocument::fromJson(file.readAll());
+            object = document.object();
+        }
+
+        const int height = qBound(44, object.value(QStringLiteral("height"))
+                                          .toInt(54), 72);
+        if (height != m_height) {
+            m_height = height;
+            emit heightChanged();
+        }
+        auto applyBool = [this, &object](const QString &key, bool defaultValue,
+                                         bool &member, void (TaskbarSettings::*signal)()) {
+            const bool value = object.value(key).toBool(defaultValue);
+            if (value != member) {
+                member = value;
+                emit (this->*signal)();
+            }
+        };
+        applyBool(QStringLiteral("groupDuplicates"), true, m_groupDuplicates,
+                  &TaskbarSettings::groupDuplicatesChanged);
+        applyBool(QStringLiteral("showTray"), true, m_showTray,
+                  &TaskbarSettings::showTrayChanged);
+        applyBool(QStringLiteral("showVolume"), true, m_showVolume,
+                  &TaskbarSettings::showVolumeChanged);
+        applyBool(QStringLiteral("showNetwork"), true, m_showNetwork,
+                  &TaskbarSettings::showNetworkChanged);
+        applyBool(QStringLiteral("showBattery"), true, m_showBattery,
+                  &TaskbarSettings::showBatteryChanged);
+        applyBool(QStringLiteral("showClock"), true, m_showClock,
+                  &TaskbarSettings::showClockChanged);
+        applyBool(QStringLiteral("showCount"), true, m_showCount,
+                  &TaskbarSettings::showCountChanged);
+        applyBool(QStringLiteral("showTitles"), true, m_showTitles,
+                  &TaskbarSettings::showTitlesChanged);
+    }
+
+signals:
+    void heightChanged();
+    void groupDuplicatesChanged();
+    void showTrayChanged();
+    void showVolumeChanged();
+    void showNetworkChanged();
+    void showBatteryChanged();
+    void showClockChanged();
+    void showCountChanged();
+    void showTitlesChanged();
+
+private:
+    QString m_path;
+    QFileSystemWatcher m_watcher;
+    QTimer m_reloadTimer;
+    int m_height = 54;
+    bool m_groupDuplicates = true;
+    bool m_showTray = true;
+    bool m_showVolume = true;
+    bool m_showNetwork = true;
+    bool m_showBattery = true;
+    bool m_showClock = true;
+    bool m_showCount = true;
+    bool m_showTitles = true;
 };
 

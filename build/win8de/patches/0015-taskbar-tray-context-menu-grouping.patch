+QString resolveThemeIcon(const QString &name)
+{
+    if (name.isEmpty())
+        return {};
+    const QStringList dirs = {
+        QStringLiteral("/usr/share/icons/Papirus/24x24/panel"),
+        QStringLiteral("/usr/share/icons/Papirus/24x24/actions"),
+        QStringLiteral("/usr/share/icons/Papirus/24x24/status"),
+        QStringLiteral("/usr/share/icons/Papirus/24x24/devices"),
+        QStringLiteral("/usr/share/icons/Papirus/48x48/panel"),
+        QStringLiteral("/usr/share/icons/Papirus/48x48/status"),
+        QStringLiteral("/usr/share/icons/Papirus/48x48/devices"),
+        QStringLiteral("/usr/share/icons/Papirus/48x48/apps"),
+        QStringLiteral("/usr/share/icons/Papirus/48x48/actions"),
+        QStringLiteral("/usr/share/icons/Papirus/64x64/panel"),
+        QStringLiteral("/usr/share/icons/Papirus/64x64/status"),
+        QStringLiteral("/usr/share/icons/Papirus/64x64/devices"),
+        QStringLiteral("/usr/share/icons/Papirus/64x64/apps"),
+        QStringLiteral("/usr/share/icons/hicolor/scalable/status"),
+        QStringLiteral("/usr/share/icons/hicolor/scalable/devices"),
+        QStringLiteral("/usr/share/icons/hicolor/scalable/apps"),
+        QStringLiteral("/usr/share/icons/hicolor/48x48/status"),
+        QStringLiteral("/usr/share/icons/hicolor/48x48/devices"),
+        QStringLiteral("/usr/share/icons/hicolor/48x48/apps"),
+        QStringLiteral("/usr/share/icons/Adwaita/48x48/status"),
+        QStringLiteral("/usr/share/icons/Adwaita/48x48/devices"),
+        QStringLiteral("/usr/share/icons/Adwaita/48x48/apps"),
+        QStringLiteral("/usr/share/pixmaps"),
+    };
+    for (const QString &dir : dirs) {
+        for (const QString &suffix : {QStringLiteral(".svg"), QStringLiteral(".png")}) {
+            const QString path = dir + QLatin1Char('/') + name + suffix;
+            if (QFile::exists(path))
+                return QUrl::fromLocalFile(path).toString();
+        }
+    }
+    return {};
+}
+
+QString readTextFile(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly))
+        return {};
+    return QString::fromUtf8(file.readAll()).trimmed();
+}
+
+QString runText(const QString &program, const QStringList &arguments,
+                int timeoutMs = 1200)
+{
+    QProcess process;
+    process.start(program, arguments);
+    if (!process.waitForFinished(timeoutMs))
+        return {};
+    return QString::fromUtf8(process.readAllStandardOutput()).trimmed();
+}

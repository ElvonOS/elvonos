+                                    && tile.x === modelX && tile.y === modelY)
+                                return
+                            console.log("↩ reset launch state:", tile.name,
+                                        "tile", tile.x, tile.y,
+                                        "model", modelX, modelY)
+                            tile.launching = false
+                            container.anyTileLaunching = false

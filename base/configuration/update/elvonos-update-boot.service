[Unit]
Description=Apply staged ElvonOS updates (boot fallback)
DefaultDependencies=no
After=local-fs.target
Before=graphical.target
ConditionPathExists=/etc/elvonos/auto-apply.enabled
ConditionPathExists=/var/lib/elvonos/update/staged.json
ConditionPathExists=!/run/live

[Service]
Type=oneshot
ExecStart=-/usr/bin/elvonos-update apply --staged
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
# ElvonOS V1 — swaybar status line with a clickable Start menu
# Uses the i3bar JSON protocol. Clicking the Start block opens elvonos-menu.
import json
import os
import subprocess
import sys
import threading
import time
from datetime import datetime

IP = "/usr/sbin/ip" if os.path.exists("/usr/sbin/ip") else "ip"


def network_address():
    try:
        out = subprocess.check_output(
            [IP, "-4", "route", "get", "1.1.1.1"],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
        parts = out.split()
        if "src" in parts:
            return parts[parts.index("src") + 1]
    except Exception:
        pass
    return "Offline"


def click_reader():
    for line in sys.stdin:
        line = line.strip().lstrip(",")
        if not line:
            continue
        try:
            event = json.loads(line)
        except Exception:
            continue
        if event.get("name") == "start" and event.get("button") == 1:
            try:
                subprocess.Popen(
                    ["/usr/bin/elvonos-menu"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except Exception:
                pass


def block(name, text, **kwargs):
    item = {"name": name, "full_text": text}
    item.update(kwargs)
    return item


def main():
    threading.Thread(target=click_reader, daemon=True).start()

    # i3bar protocol header
    print('{"version":1,"click_events":true}', flush=True)
    print("[", flush=True)

    start = block(
        "start",
        "  Start  ",
        color="#181926",
        background="#8aadf4",
        border="#8aadf4",
        border_top=0,
        border_bottom=2,
        border_left=0,
        border_right=0,
        min_width=80,
        align="center",
    )

    net = "Offline"
    net_time = 0.0
    while True:
        now = datetime.now()
        if time.time() - net_time >= 5:
            net = network_address()
            net_time = time.time()
        blocks = [
            start,
            block("net", f"  NET: {net}  ", color="#cad3f5"),
            block("clock", f"  {now:%H:%M}  {now:%d.%m.%Y}  ", color="#cad3f5"),
        ]
        sys.stdout.write(json.dumps(blocks, ensure_ascii=False) + ",\n")
        sys.stdout.flush()
        time.sleep(1)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)

[Desktop Entry]
Type=Application
Name=Waydroid
GenericName=Android Container
Exec=elvonos-waydroid
Comment=Run Android apps in a containerized environment.
Icon=waydroid
Categories=X-WayDroid-App;Utility;
Actions=stop;sync;initialize;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action stop]
Name=Stop Waydroid
Name[de]=Waydroid stoppen
Exec=elvonos-waydroid stop
Icon=waydroid

[Desktop Action sync]
Name=Refresh Android apps
Name[de]=Android-Apps aktualisieren
Exec=elvonos-waydroid sync
Icon=view-refresh

[Desktop Action initialize]
Name=Initialize Waydroid
Name[de]=Waydroid initialisieren
Exec=waydroid init --client
Icon=waydroid

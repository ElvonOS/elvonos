#!/bin/sh
# Searchable system menu used by the "System" desktop icon.
# Creates a temporary XDG application directory that contains only
# System/Settings entries, then opens wofi's searchable launcher.
set -eu

TMPDIR_BASE="${XDG_RUNTIME_DIR:-/tmp}"
WORK="$(mktemp -d "$TMPDIR_BASE/elvonos-system-menu.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/applications"

count=0
for file in /usr/share/applications/*.desktop \
            "${HOME}/.local/share/applications"/*.desktop; do
    [ -f "$file" ] || continue
    if grep -qiE '^Categories=.*(System|Settings)' "$file"; then
        ln -sf "$file" "$WORK/applications/$(basename "$file")"
        count=$((count + 1))
    fi
done

# Fall back to the full application list if no system entries were found.
if [ "$count" -eq 0 ]; then
    for file in /usr/share/applications/*.desktop; do
        [ -f "$file" ] || continue
        ln -sf "$file" "$WORK/applications/$(basename "$file")"
    done
fi

export XDG_DATA_DIRS="$WORK:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if command -v wofi >/dev/null 2>&1; then
    exec wofi --show drun --prompt "Search system apps…" \
        --conf /etc/wofi/elvonos-menu.conf
fi
# Fallback: the Start screen (single-instance toggle).
exec Win8Start

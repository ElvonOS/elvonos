#!/bin/bash
# ElvonOS Flathub setup
#
# Installs Flatpak if needed and adds the official Flathub remote, following
# https://flatpak.org/setup/ . Used by the Store ("Set up Flathub") and by the
# signed update component of the same name.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        exec sudo -n "$0" "$@"
    fi
    echo "Root privileges are required to set up Flatpak." >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Installing Flatpak…"
    apt-get update
    apt-get install -y --no-install-recommends flatpak
fi

echo "Adding the Flathub remote…"
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

# Refresh AppStream data so the Store sees the catalog.
flatpak update --appstream -y >/dev/null 2>&1 || true

if flatpak remotes --columns=name | grep -qx flathub; then
    echo "Flathub is configured."
else
    echo "Flathub setup failed." >&2
    exit 1
fi

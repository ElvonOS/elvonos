#!/usr/bin/env bash
# ElvonOS update client
#
#   elvonos-update check      → JSON status (ISO + component updates)
#   elvonos-update download   → download and verify the next ISO
#   elvonos-update apply      → apply package + signed component updates
#   elvonos-update status     → current version and feed URL
#
# The feed is a signed JSON file. Component updates are small signed scripts
# (for example the Flathub setup for the Store) that can ship without a new ISO.
set -euo pipefail

# systemd units have no HOME; the updater needs it for its cache/log paths.
HOME="${HOME:-/root}"

CONF=${ELVONOS_UPDATE_CONF:-/etc/elvonos/update.conf}
[ -f "$CONF" ] && . "$CONF"

FEED_URL="${FEED_URL:-https://downloads.sourceforge.net/project/elvonos/feeds/stable.json}"
FEED_FALLBACKS="${FEED_FALLBACKS:-https://raw.githubusercontent.com/ElvonOS/elvonos-updates/main/feeds/stable.json https://codeberg.org/ElvonOS/elvonos-updates/raw/branch/main/feeds/stable.json}"
PUBKEY="${PUBKEY:-/usr/share/elvonos/update/elvonos.pub}"
CURRENT="${CURRENT:-$(sed -n 's/^VERSION=//p' /etc/elvonos-release 2>/dev/null || echo 0)}"
CACHE="${CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/elvonos/update}"
COMPONENTS="${COMPONENTS:-/var/lib/elvonos/components}"
FEED="$CACHE/stable.json"
STAGED_DIR="${STAGED_DIR:-/var/lib/elvonos/update}"
STAGED_FEED="$STAGED_DIR/feed.json"

if [ "$(id -u)" -eq 0 ]; then
    LOG="${ELVONOS_UPDATE_LOG:-/var/log/elvonos-update.log}"
else
    LOG="${ELVONOS_UPDATE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/elvonos-update.log}"
fi
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 524288 ]; then
    tail -n 2000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" || true
fi
chmod 0644 "$LOG" 2>/dev/null || true

need() { command -v "$1" >/dev/null || { echo "missing: $1" >&2; exit 1; }; }
need curl
need minisign
need jq

log() {
    local line="[$(date -Is)] $*"
    echo "$line" >&2
    printf '%s\n' "$line" >> "$LOG" 2>/dev/null || true
}
die() { log "ERROR: $*"; exit 1; }

# Keep two concurrent runs from stepping on each other.
LOCK="${TMPDIR:-/tmp}/elvonos-update.lock"
exec 9>"$LOCK"
flock -n 9 || die "another update is already running"

fetch() {
    # fetch <url> <output> with retries (connection resets, timeouts)
    local url="$1" out="$2" try
    for try in 1 2 3 4; do
        if curl -fsSL --connect-timeout 15 --max-time 900 \
                --retry 2 --retry-delay 2 "$url" -o "$out.part"; then
            mv "$out.part" "$out"
            return 0
        fi
        log "download failed ($try/4): $url"
        sleep $((try * 2))
    done
    return 1
}

fetch_feed() {
    mkdir -p "$CACHE"
    local url
    for url in $FEED_URL $FEED_FALLBACKS; do
        if fetch "$url" "$FEED" && fetch "$url.minisig" "$FEED.minisig" && \
           minisign -Vm "$FEED" -p "$PUBKEY" >/dev/null 2>&1; then
            FEED_SOURCE="$url"
            log "feed: $url"
            return 0
        fi
        log "feed unavailable: $url"
    done
    log "no signed feed reachable"
    return 1
}

# version_gt A B → true when A is newer than B (sort -V order)
version_gt() {
    [ "$1" != "$2" ] && \
        [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

component_installed() {
    local id="$1"
    [ -f "$COMPONENTS/$id.version" ] && cat "$COMPONENTS/$id.version" || true
}

pending_components_json() {
    local id want have items="[]"
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        type=$(jq -r --arg id "$id" '.components[$id].type // "script"' "$FEED")
        case "$type" in
            payload|script) ;;
            *) log "ignoring component $id: unknown type $type"; continue ;;
        esac
        want=$(jq -r --arg id "$id" '.components[$id].version' "$FEED")
        have=$(component_installed "$id")
        if [ -z "$have" ] || version_gt "$want" "$have"; then
            items=$(jq -c --arg id "$id" --arg want "$want" --arg have "$have" \
                '. + [{id:$id, version:$want, installed:$have}]' <<<"$items")
        fi
    done < <(jq -r '.components // {} | keys[]' "$FEED")
    printf '%s' "$items"
}

iso_update_available() {
    local latest
    latest=$(jq -r .version "$FEED")
    version_gt "$latest" "$CURRENT"
}

cmd_check() {
    fetch_feed || die "no signed feed reachable"
    local latest iso comps update os_updates
    latest=$(jq -r .version "$FEED")
    iso=false
    iso_update_available && iso=true
    comps=$(pending_components_json)
    os_updates=$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ' || true)
    [ -n "$os_updates" ] || os_updates=0
    update=false
    if [ "$iso" = true ] || [ "$(jq 'length' <<<"$comps")" -gt 0 ] || [ "$os_updates" -gt 0 ]; then
        update=true
    fi
    jq -n --arg current "$CURRENT" --arg latest "$latest" \
        --argjson iso "$iso" --argjson components "$comps" \
        --argjson os_updates "$os_updates" --argjson update "$update" \
        '{current:$current, latest:$latest, update:$update, iso:$iso,
          os_updates:$os_updates, components:$components}'
    log "check: latest=$latest iso=$iso os=$os_updates components=$(jq 'length' <<<"$comps")"
}

cmd_download() {
    fetch_feed || die "no signed feed reachable"
    local url sha out
    url=$(jq -r '.iso.url // empty' "$FEED")
    [ -n "$url" ] || die "feed has no ISO entry"
    sha=$(jq -r '.iso.sha256' "$FEED")
    out="$CACHE/$(basename "$url")"
    log "downloading ISO: $url"
    curl -fL --retry 3 --continue-at - "$url" -o "$out.part"
    echo "$sha  $out.part" | sha256sum -c - >/dev/null || die "ISO checksum mismatch"
    fetch "$url.minisig" "$out.minisig"
    minisign -Vm "$out.part" -p "$PUBKEY" >/dev/null 2>&1 || die "ISO signature is invalid"
    mv "$out.part" "$out"
    log "ISO saved: $out"
    echo "$out"
}

prepare_component() {
    local id="$1" want="$2" url="$3" sha="$4" tmp="$CACHE/$1"
    if [ -f "$tmp" ] && [ -f "$tmp.minisig" ] && \
       echo "$sha  $tmp" | sha256sum -c - >/dev/null 2>&1 && \
       minisign -Vm "$tmp" -p "$PUBKEY" >/dev/null 2>&1; then
        log "using staged component $id $want"
        return 0
    fi
    log "downloading component $id $want"
    fetch "$url" "$tmp"
    fetch "$url.minisig" "$tmp.minisig"
    minisign -Vm "$tmp" -p "$PUBKEY" >/dev/null 2>&1 || \
        die "component $id signature is invalid"
    echo "$sha  $tmp" | sha256sum -c - >/dev/null || \
        die "component $id checksum mismatch"
}

apply_components() {
    local ids id want have url sha type tmp
    ids=$(jq -r '.components // {} | keys[]' "$FEED")
    [ -n "$ids" ] || return 0
    mkdir -p "$COMPONENTS"
    for id in $ids; do
        want=$(jq -r --arg id "$id" '.components[$id].version' "$FEED")
        have=$(component_installed "$id")
        if [ -n "$have" ] && ! version_gt "$want" "$have"; then
            continue
        fi
        type=$(jq -r --arg id "$id" '.components[$id].type // "script"' "$FEED")
        url=$(jq -r --arg id "$id" '.components[$id].url' "$FEED")
        sha=$(jq -r --arg id "$id" '.components[$id].sha256' "$FEED")
        [ -n "$url" ] && [ -n "$sha" ] || die "component $id is incomplete in the feed"
        tmp="$CACHE/$id"
        prepare_component "$id" "$want" "$url" "$sha"
        log "applying $type component $id $want"
        case "$type" in
            payload) install_payload "$tmp" "$id" ;;
            script)  bash "$tmp" ;;
            *)       log "skipping $id: unknown component type $type"; continue ;;
        esac
        printf '%s\n' "$want" > "$COMPONENTS/$id.version"
    done
}

validate_payload() {
    local file="$1" list="$CACHE/payload.list" path target
    tar --zstd -tf "$file" > "$list"
    while IFS= read -r path; do
        case "$path" in
            usr/*|etc/elvonos/*|etc/elvonos|\
            etc/systemd/system/elvonos-*|\
            etc/systemd/system/*.target.wants/elvonos-*) ;;
            *) die "payload path outside the allowlist: $path" ;;
        esac
        case "$path" in
            /*|*..*) die "payload path is unsafe: $path" ;;
        esac
    done < "$list"
    while IFS= read -r target; do
        case "$target" in
            /*)
                case "$target" in
                    /usr/*|/etc/elvonos/*|/etc/systemd/system/elvonos-*) ;;
                    *) die "payload symlink target outside the allowlist: $target" ;;
                esac
                ;;
            *..*)
                die "payload symlink target is unsafe: $target"
                ;;
        esac
    done < <(tar --zstd -tvf "$file" | grep ' -> ' | sed 's/.* -> //' || true)
}

backup_system_config() {
    [ -d /etc ] || return 0
    mkdir -p /var/backups/elvonos 2>/dev/null || return 0
    local stamp file
    stamp=$(date +%Y%m%d-%H%M%S)
    file="/var/backups/elvonos/etc-$stamp.tar.gz"
    tar -czf "$file" -C / etc >/dev/null 2>&1 || true
    ls -1t /var/backups/elvonos/etc-*.tar.gz 2>/dev/null |
        tail -n +4 | xargs -r rm -f
}

install_payload() {
    local file="$1" id="$2"
    validate_payload "$file"
    tar --zstd -xpf "$file" -C /
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi
    ldconfig 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
}

refresh_store_catalog() {
    # Refresh appstream data so the Store sees new Flatpak applications.
    if command -v flatpak >/dev/null 2>&1; then
        flatpak update --appstream -y >/dev/null 2>&1 || true
    fi
}

cmd_apply() {
    local staged="${1:-}"
    if [ -d /run/live ]; then
        echo "This is a live session. Use 'elvonos-update download' and write the ISO to a USB stick." >&2
        return 1
    fi
    [ -f /etc/debian_version ] || die "not an installed ElvonOS system"

    if [ "$(id -u)" -ne 0 ]; then
        if sudo -n true 2>/dev/null; then
            exec sudo -n "$0" apply "$@"
        fi
        die "root privileges required (run with sudo or pkexec)"
    fi

    if [ "$staged" = "--staged" ]; then
        [ -f "$STAGED_FEED" ] || die "no staged update feed"
        minisign -Vm "$STAGED_FEED" -p "$PUBKEY" >/dev/null 2>&1 || \
            die "staged feed signature is invalid"
        FEED="$STAGED_FEED"
        log "applying staged updates (offline-capable)"
    else
        fetch_feed || die "no signed feed reachable"
    fi
    export DEBIAN_FRONTEND=noninteractive
    backup_system_config
    if [ "$staged" != "--staged" ]; then
        log "updating package lists"
        apt-get -o Acquire::Retries=3 update || \
            log "package list update failed, continuing with components"
    else
        log "applying staged updates"
    fi
    log "upgrading packages"
    local apt_ok=1
    apt-get -y -o Acquire::Retries=3 -o Dpkg::Options::="--force-confold" upgrade || {
        log "package upgrade failed, continuing with components"
        apt_ok=0
    }
    apply_components
    if [ "$apt_ok" -eq 1 ]; then
        rm -f "$STAGED_DIR/staged.json" "$STAGED_FEED" "$STAGED_FEED.minisig"
    else
        log "keeping staged updates for the next boot"
    fi
    refresh_store_catalog
    log "update finished"
}

cmd_stage() {
    if [ "$(id -u)" -ne 0 ]; then
        die "staging requires root"
    fi
    fetch_feed
    export DEBIAN_FRONTEND=noninteractive
    log "staging: updating package lists"
    apt-get -o Acquire::Retries=3 update || log "package list update failed"
    log "staging: downloading packages"
    apt-get -y -d -o Acquire::Retries=3 upgrade || log "package download failed"

    local ids id want have url sha type
    ids=$(jq -r '.components // {} | keys[]' "$FEED")
    for id in $ids; do
        want=$(jq -r --arg id "$id" '.components[$id].version' "$FEED")
        have=$(component_installed "$id")
        if [ -n "$have" ] && ! version_gt "$want" "$have"; then
            continue
        fi
        type=$(jq -r --arg id "$id" '.components[$id].type // "script"' "$FEED")
        case "$type" in
            payload|script) ;;
            *) continue ;;
        esac
        url=$(jq -r --arg id "$id" '.components[$id].url' "$FEED")
        sha=$(jq -r --arg id "$id" '.components[$id].sha256' "$FEED")
        prepare_component "$id" "$want" "$url" "$sha"
    done

    mkdir -p "$STAGED_DIR"
    cp -f "$FEED" "$STAGED_FEED"
    cp -f "$FEED.minisig" "$STAGED_FEED.minisig"
    jq -n --arg version "$(jq -r .version "$FEED")" \
        --arg feed "$FEED_SOURCE" \
        --arg time "$(date -Is)" \
        --argjson components "$(pending_components_json)" \
        '{version:$version, feed:$feed, staged:$time, components:$components}' \
        > "$STAGED_DIR/staged.json"
    log "staged: $(jq -c . "$STAGED_DIR/staged.json")"
}

write_status() {
    mkdir -p "$STAGED_DIR"
    jq -n --arg time "$(date -Is)" --arg result "$1" \
        --arg version "$CURRENT" \
        '{last_run:$time, result:$result, version:$version}' \
        > "$STAGED_DIR/status.json" 2>/dev/null || true
}

cmd_auto() {
    if [ "$(id -u)" -ne 0 ]; then
        die "automatic updates require root"
    fi
    fetch_feed || { log "auto: no feed"; write_status "no-feed"; exit 0; }
    local comps os
    comps=$(pending_components_json)
    os=$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ' || true)
    [ -n "$os" ] || os=0
    if [ "$(jq 'length' <<<"$comps")" -gt 0 ] || [ "$os" -gt 0 ]; then
        cmd_stage
        write_status "staged"
    else
        rm -f "$STAGED_DIR/staged.json" "$STAGED_FEED" "$STAGED_FEED.minisig"
        log "auto: no updates available"
        write_status "up-to-date"
    fi
}

cmd_status() {
    jq -n --arg current "$CURRENT" --arg feed "$FEED_URL" \
        --argjson components "$(jq -n '{}')" \
        '{current:$current, feed:$feed}'
}

cmd_verify_payload() {
    local file="${1:-}"
    [ -f "$file" ] || die "usage: elvonos-update verify-payload FILE"
    mkdir -p "$CACHE"
    validate_payload "$file"
    [ -f "$file.minisig" ] || die "payload signature missing: $file.minisig"
    minisign -Vm "$file" -p "$PUBKEY" >/dev/null 2>&1 || \
        die "payload signature is invalid"
    echo "valid"
}

cmd_log() {
    local shown=0
    for f in /var/log/elvonos-update.log \
             "${XDG_STATE_HOME:-$HOME/.local/state}/elvonos-update.log"; do
        if [ -r "$f" ]; then
            echo "== $f =="
            tail -n 100 "$f"
            shown=1
        fi
    done
    [ "$shown" = 1 ] || echo "no update log yet"
}

case "${1:-check}" in
    check)    cmd_check ;;
    download) cmd_download ;;
    apply)    cmd_apply "${2:-}" ;;
    stage)    cmd_stage ;;
    auto)     cmd_auto ;;
    status)   cmd_status ;;
    log)      cmd_log ;;
    verify-payload) cmd_verify_payload "${2:-}" ;;
    *)
        echo "Usage: elvonos-update check|download|apply [--staged]|stage|auto|status|log|verify-payload FILE" >&2
        exit 2
        ;;
esac

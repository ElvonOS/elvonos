build-essential
cmake
ninja-build
pkg-config
meson
git
patch
quilt
file
tree
shellcheck
ca-certificates
apt-utils

# Debian packaging
debhelper
devscripts
equivs
lintian
dh-python
dh-apparmor
fakeroot
dpkg-dev
reprepro
gnupg

# Python packaging
python3
python3-dev
python3-pip
python3-venv
python3-setuptools
python3-build
python3-installer
pybuild-plugin-pyproject

# Root filesystem and ISO
mmdebstrap
debootstrap
live-build
squashfs-tools
xorriso
grub-efi-amd64-bin
grub-pc-bin
mtools
dosfstools
parted
gdisk
e2fsprogs
cryptsetup-bin
btrfs-progs
os-prober
efibootmgr
shim-signed
grub-efi-amd64-signed
isolinux
syslinux-common

# VM test support (supplementary; physical hardware is the release gate)
